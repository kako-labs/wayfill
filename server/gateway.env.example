# Copy outside the repository (e.g. ~/Documents/fuel-pilot-run/gateway.env), chmod 600, fill in the keys.
# Opinet: one key or several numbered keys; each has its own 300/day quota and they are used in order.
OPINET_API_KEY_1=
OPINET_API_KEY_2=
KAKAO_REST_API_KEY=
WAYFILL_HOST=127.0.0.1
WAYFILL_PORT=18787
# Quota databases live here; keep it outside the repository and back it up with the env file.
WAYFILL_DATA_DIR=/home/USER/Documents/fuel-pilot-run/data
# Only behind the Cloudflare tunnel on loopback: per-client limits use CF-Connecting-IP.
WAYFILL_TRUST_PROXY=true
WAYFILL_ROUTING_DAILY_LIMIT=1000
# Interpreter for server/run.sh (Python 3.11+, standard library only).
WAYFILL_PYTHON=/usr/bin/python3
